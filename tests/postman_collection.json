    {
      "name": "06 Budgets",
      "item": [
        {
          "name": "Create budget (201, persisted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// v1 returned a fabricated id:1 and wrote nothing.",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('request uses dateRange, response uses date_range', () => pm.expect(body).to.have.property('date_range'));",
                  "pm.collectionVariables.set('budget_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"category\":{\"name\":\"Food\",\"profit\":false},\"total\":{\"amount\":\"500.00\",\"currency\":\"PLN\"},\"dateRange\":{\"start\":\"2024-01-01\",\"end\":\"2024-12-31\"}}" },
            "url": { "raw": "{{base_url}}/resources/users/user1/budgets", "host": ["{{base_url}}"], "path": ["resources", "users", "user1", "budgets"] }
          }
        },
        {
          "name": "List budgets with spent and left",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const created = pm.response.json().find(b => b.id === Number(pm.collectionVariables.get('budget_id')));",
                  "pm.test('the budget was really persisted', () => pm.expect(created).to.not.be.undefined);",
                  "pm.test('reports spent and left', () => {",
                  "  pm.expect(created).to.have.property('spent');",
                  "  pm.expect(Number(created.left.amount)).to.eql(500 - Number(created.spent.amount));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/resources/users/user1/budgets", "host": ["{{base_url}}"], "path": ["resources", "users", "user1", "budgets"] }
          }
        },
        {
          "name": "Unknown category (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('names the category', () => pm.expect(pm.response.json().message).to.include('does not exist'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"category\":{\"name\":\"NoSuchCategory\",\"profit\":false},\"total\":{\"amount\":\"1.00\",\"currency\":\"PLN\"},\"dateRange\":{\"start\":\"2024-01-01\",\"end\":\"2024-12-31\"}}" },
            "url": { "raw": "{{base_url}}/resources/users/user1/budgets", "host": ["{{base_url}}"], "path": ["resources", "users", "user1", "budgets"] }
          }
        },
        {
          "name": "Inverted date range (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('explains the range', () => pm.expect(pm.response.json().message).to.include('Invalid date range'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"category\":{\"name\":\"Food\",\"profit\":false},\"total\":{\"amount\":\"1.00\",\"currency\":\"PLN\"},\"dateRange\":{\"start\":\"2024-12-31\",\"end\":\"2024-01-01\"}}" },
            "url": { "raw": "{{base_url}}/resources/users/user1/budgets", "host": ["{{base_url}}"], "path": ["resources", "users", "user1", "budgets"] }
          }
        },
        {
          "name": "Delete budget (204)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/resources/users/user1/budgets/{{budget_id}}", "host": ["{{base_url}}"], "path": ["resources", "users", "user1", "budgets", "{{budget_id}}"] }
          }
        }
      ]
    },
