          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/resources/users/user1/wallets/{{wallet_id}}/highest_expense", "host": ["{{base_url}}"], "path": ["resources", "users", "user1", "wallets", "{{wallet_id}}", "highest_expense"] }
